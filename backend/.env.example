# ChurchTrack Backend — copy to .env and fill in real values
# cp .env.example .env

PORT=3000

# Required in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# MongoDB Atlas or local MongoDB connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/sallehub
MONGO_DB_NAME=sallehub

# Cloudinary — required for hall image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional unsigned upload preset (Settings → Upload → Upload presets)
# CLOUDINARY_UPLOAD_PRESET=sallehub_halls

# Optional
GEMINI_API_KEY=

# Allowed frontend origin for CORS (production URL or local Vite)
FRONTEND_URL=http://localhost:5173

# Super administrator bootstrap account (private values; replace locally)
SUPERADMIN_EMAIL=your-superadmin-email@example.com
SUPERADMIN_PASSWORD=change-this-superadmin-password
