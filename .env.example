# ========================================
# SALLEHUB - BACKEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to backend/.env and fill in your values

# Server Configuration
PORT=3000

# JWT Secret for admin authentication
JWT_SECRET=sallehub-super-secure-jwt-secret-key-2026

# MongoDB (optional - leave empty to use JSON file storage)
MONGO_URI=
MONGO_DB_NAME=sallehub

# Cloudinary (required for hall image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: unsigned upload preset (Settings → Upload → Upload presets).
# Use this if your API key lacks "create" permission.
# CLOUDINARY_UPLOAD_PRESET=sallehub_halls

# Gemini AI API Key (optional)
GEMINI_API_KEY=

# Frontend URL for CORS (update this to match your frontend deployment)
FRONTEND_URL=http://localhost:5173

# ========================================
# SALLEHUB - FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Copy this section to frontend/.env

# Backend API URL (update this to match your backend server)
# VITE_API_URL=http://localhost:3000

# For production deployment:
# VITE_API_URL=https://your-backend-url.onrender.com
